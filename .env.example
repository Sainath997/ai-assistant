# === LLM Providers (set whichever you use) ===
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_BASE_URL=http://localhost:11434

# === Active LLM provider: openai | anthropic | ollama ===
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# === App settings ===
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-secret

# === Memory / Vector DB ===
CHROMA_PERSIST_DIR=./memory/chroma_db

# === Search ===
# DuckDuckGo is free, no key needed
# Optional: Tavily for better results
TAVILY_API_KEY=

# === Calendar (optional CalDAV) ===
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
